def classifier_continuation(prompt):
    encoded = base64.urlsafe_b64encode(
        json.dumps({"prompt": prompt}, separators=(",", ":")).encode()
    ).decode()
    return f"classifier:{encoded}"


def classifier_prompt(context, prompt):
    conversation = (context.get("conversation") or {}).get("recentMessages", [])
    messages = []
    for message in conversation[-8:]:
        if not isinstance(message, dict):
            continue
        role = message.get("role")
        text = message.get("text")
        if role in ("user", "assistant") and isinstance(text, str):
            messages.append(f"{role}: {text[:768]}")
    scope = ((context.get("turn") or {}).get("scope") or "root")
    return (
        "Classify the candidate task for a model router. Return JSON only with "
        "exactly these fields: complexity (low, medium, high, very_high), risk "
        "(low, medium, high, very_high), orchestration (none, delegate, coordination, workflow), "
        "confidence (number from 0 through 1 for your complexity, risk, and orchestration classification). "
        "For a subagent, choose orchestration none unless the candidate explicitly "
        "asks it to delegate, spawn, coordinate, or split work.\n"
        f"Scope: {scope}\n"
        f"Recent session context:\n{chr(10).join(messages)[:6000]}\n"
        f"Candidate task:\n{prompt[:1500]}"
    )


def parse_classifier_output(output):
    if not isinstance(output, str):
        return None
    candidate = output.strip()
    if candidate.startswith("```"):
        candidate = re.sub(r"^```(?:json)?\s*|\s*```$", "", candidate)
    try:
        value = json.loads(candidate)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", candidate, re.DOTALL)
        if match is None:
            return None
        try:
            value = json.loads(match.group(0))
        except json.JSONDecodeError:
            return None
    if not isinstance(value, dict):
        return None
    result = {
        axis: value.get(axis)
        for axis in ("complexity", "risk", "orchestration")
    }
    confidence = value.get("confidence")
    if (
        result["complexity"] not in COMPLEXITIES
        or result["risk"] not in RISKS
        or result["orchestration"] not in ORCHESTRATIONS
        or not isinstance(confidence, (int, float))
        or isinstance(confidence, bool)
        or not math.isfinite(confidence)
        or not 0.0 <= confidence <= 1.0
    ):
        return None
    result["confidence"] = confidence
    return result


def routing_classifier_response(request, policy):
    params = request.get("params") or {}
    continuation = params.get("continuation")
    if not isinstance(continuation, str) or not continuation.startswith("classifier:"):
        raise ValueError("invalid classifier continuation")
    try:
        state = json.loads(
            base64.urlsafe_b64decode(continuation.split(":", 1)[1].encode())
        )
        prompt = state["prompt"]
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        raise ValueError("invalid classifier continuation") from None
    if not isinstance(prompt, str):
        raise ValueError("invalid classifier continuation")
    llm_elapsed_ms = params.get("elapsedMs")
    if (
        llm_elapsed_ms is not None
        and (
            not isinstance(llm_elapsed_ms, int)
            or isinstance(llm_elapsed_ms, bool)
            or llm_elapsed_ms < 0
        )
    ):
        raise ValueError("invalid classifier elapsed time")
    classifier_output = parse_classifier_output(params.get("output"))
    if classifier_output is None:
        record_diagnostic(
            {
                "event": "model_classifier_fallback",
                "recordedAtUnixSeconds": int(time.time()),
                "reason": params.get("error", "invalid classifier output"),
            }
        )
    return routing_decide(
        {
            **request,
            "params": {
                **params,
                "prompt": prompt,
            },
        },
        policy,
        classifier_output,
        llm_elapsed_ms,
    )


def routing_decide(request, policy, llm_classification=None, llm_elapsed_ms=None):
    context = request.get("context", {})
    turn = context.get("turn", {})
    prompt = (request.get("params") or {}).get("prompt", "")
    recent_messages = (context.get("conversation") or {}).get("recentMessages", [])
    has_prior_messages = isinstance(recent_messages, list) and bool(recent_messages)
    scope = turn.get("scope", "root")
    configured_classifier = valid_route(
        policy.get("classifierRoute"), eligible_classifier_routes(context)
    )
    if (
        llm_classification is None
        and configured_classifier is not None
        and not (
            has_prior_messages
            and (steering_prompt(prompt) or explicit_continuation_prompt(prompt))
        )
    ):
        return {
            "kind": "classifierRequest",
            "classifier": {
                "continuation": classifier_continuation(prompt),
                "route": configured_classifier,
                "input": classifier_prompt(context, prompt),
            },
        }
    (
        axes,
        evidence,
        steering,
        embedding_elapsed_ms,
        embedding_input_count,
        llm_confidence,
    ) = classify(
        policy,
        prompt,
        has_prior_messages,
        recent_messages,
        scope,
        llm_classification,
    )
    similarity, margin = classification_confidence(evidence)
    calibrated_confidence, raw_confidence = combined_confidence(
        policy, similarity, llm_confidence
    )
    selection = choose_route(policy, context, axes)
    route = selection["route"]
    confident = confidence_passes(
        policy,
        calibrated_confidence
        if calibrated_confidence is not None
        else similarity,
        margin,
    )
    scope = turn.get("scope")
    active = turn.get("active", False)
    mode = effective_mode(policy, context)
    enabled = mode == "full" or (mode == "subagents" and scope == "subagent")
    shadow = mode == "shadow-full" or (
        mode == "shadow-subagents" and scope == "subagent"
    )
    route_can_be_applied = (
        enabled and not active and not steering and route is not None and confident
    )
    should_shadow = (
        shadow and not active and not steering and route is not None and confident
    )
    current = context.get("currentRoute")
    changed = route != current
    route_can_be_approved = enabled and not active and not steering and route is not None
    needs_approval = route_can_be_approved and (
        policy["approval"] == "all"
        or (policy["approval"] == "changes" and confident and changed)
        or (policy["approval"] == "not-confident" and not confident)
    )
    if needs_approval:
        record_routing_decision(
            policy,
            context,
            axes,
            similarity,
            margin,
            selection,
            mode,
            active,
            steering,
            "approval",
            llm_confidence,
            llm_elapsed_ms,
            calibrated_confidence,
        )
        context = {
            **context,
            "routerPrompt": prompt,
        }
        return approval(
            policy,
            axes,
            similarity,
            margin,
            selection,
            context,
            embedding_elapsed_ms=embedding_elapsed_ms,
            embedding_input_count=embedding_input_count,
            llm_confidence=llm_confidence,
            llm_elapsed_ms=llm_elapsed_ms,
            calibrated_confidence=calibrated_confidence,
            raw_confidence=raw_confidence,
        )
    disposition = (
        "apply"
        if route_can_be_applied
        else "shadow"
        if should_shadow
        else "keepCurrent"
    )
    reason = None
    if steering:
        reason = "Steering input retained the current route."
    elif not confident:
        reason = "Similarity thresholds retained the current route."
    elif route is None:
        reason = "No eligible ranked route was available."
    record_routing_decision(
        policy,
        context,
        axes,
        similarity,
        margin,
        selection,
        mode,
        active,
        steering,
        disposition,
        llm_confidence,
        llm_elapsed_ms,
        calibrated_confidence,
    )
    result = decision(
        policy,
        request["requestId"],
        axes,
        similarity,
        margin,
        selection,
        disposition,
        reason,
        feedback_enabled=policy["feedback"] and mode != "off",
        embedding_elapsed_ms=embedding_elapsed_ms,
        embedding_input_count=embedding_input_count,
        llm_confidence=llm_confidence,
        llm_elapsed_ms=llm_elapsed_ms,
        calibrated_confidence=calibrated_confidence,
        used_route=route if disposition == "apply" else current,
    )
    return result


def approval_state(continuation):
    try:
        _, encoded = continuation.split(":", 1)
        state = json.loads(base64.urlsafe_b64decode(encoded.encode()))
        axes = state["axes"]
        confidence = float(state["confidence"])
        margin = float(state["margin"])
        embedding_elapsed_ms = state.get("embeddingElapsedMs")
        embedding_input_count = state.get("embeddingInputCount")
        llm_confidence = state.get("llmConfidence")
        llm_elapsed_ms = state.get("llmElapsedMs")
        calibrated_confidence = state.get("calibratedConfidence")
        raw_confidence = state.get("rawConfidence")
        was_override = state.get("wasOverride", False)
        scope = state.get("scope", "root")
        context = {
            "eligibleRoutes": state["eligibleRoutes"],
            "currentRoute": state.get("currentRoute"),
            "routerPrompt": prompt_preview(state.get("routerPrompt")),
            "turn": {"scope": scope},
        }
        policy_revision = state["policyRevision"]
        recalibrated = state.get("recalibrated", False)
        if (
            not isinstance(policy_revision, str)
            or not isinstance(recalibrated, bool)
            or not isinstance(was_override, bool)
            or scope not in ("root", "subagent")
            or embedding_elapsed_ms is not None
            and (
                not isinstance(embedding_elapsed_ms, int)
                or isinstance(embedding_elapsed_ms, bool)
                or embedding_elapsed_ms < 0
            )
            or embedding_input_count is not None
            and (
                not isinstance(embedding_input_count, int)
                or isinstance(embedding_input_count, bool)
                or embedding_input_count < 1
            )
            or (embedding_elapsed_ms is None) != (embedding_input_count is None)
            or llm_confidence is not None
            and (
                not isinstance(llm_confidence, (int, float))
                or isinstance(llm_confidence, bool)
                or not math.isfinite(llm_confidence)
                or not 0.0 <= llm_confidence <= 1.0
            )
            or llm_elapsed_ms is not None
            and (
                not isinstance(llm_elapsed_ms, int)
                or isinstance(llm_elapsed_ms, bool)
                or llm_elapsed_ms < 0
            )
            or calibrated_confidence is not None
            and (
                not isinstance(calibrated_confidence, (int, float))
                or isinstance(calibrated_confidence, bool)
                or not math.isfinite(calibrated_confidence)
                or not 0.0 <= calibrated_confidence <= 1.0
            )
            or raw_confidence is not None
            and (
                not isinstance(raw_confidence, (int, float))
                or isinstance(raw_confidence, bool)
                or not math.isfinite(raw_confidence)
                or not 0.0 <= raw_confidence <= 1.0
            )
            or axes["work_type"] not in WORK_TYPES
            or axes["complexity"] not in COMPLEXITIES
            or axes["orchestration"] not in ORCHESTRATIONS
            or axes["risk"] not in RISKS
        ):
            raise ValueError("invalid approval state")
    except (KeyError, TypeError, ValueError, json.JSONDecodeError):
        return None
    return (
        axes,
        confidence,
        margin,
        context,
        policy_revision,
        recalibrated,
        embedding_elapsed_ms,
        embedding_input_count,
        llm_confidence,
        llm_elapsed_ms,
        calibrated_confidence,
        raw_confidence,
        was_override,
    )


def fresh_approval(
    policy,
    axes,
    confidence,
    margin,
    context,
    notice_text,
    recalibrated=False,
    embedding_elapsed_ms=None,
    embedding_input_count=None,
    llm_confidence=None,
    llm_elapsed_ms=None,
    calibrated_confidence=None,
    raw_confidence=None,
    was_override=False,
):
    selection = choose_route(policy, context, axes)
    return approval(
        policy,
        axes,
        confidence,
        margin,
        selection,
        context,
        notice_text=notice_text,
        recalibrated=recalibrated,
        embedding_elapsed_ms=embedding_elapsed_ms,
        embedding_input_count=embedding_input_count,
        llm_confidence=llm_confidence,
        llm_elapsed_ms=llm_elapsed_ms,
        calibrated_confidence=calibrated_confidence,
        raw_confidence=raw_confidence,
        was_override=was_override,
    )


def approval_response(request, policy):
    params = request.get("params") or {}
    continuation = params.get("continuation", "")
    decoded = approval_state(continuation)
    if decoded is None:
        return error_notice(policy, "Invalid approval continuation.")
    (
        axes,
        confidence,
        margin,
        rendered_context,
        policy_revision,
        recalibrated,
        embedding_elapsed_ms,
        embedding_input_count,
        llm_confidence,
        llm_elapsed_ms,
        calibrated_confidence,
        raw_confidence,
        was_override,
    ) = decoded
    current_context = {**rendered_context, **(request.get("context") or {})}
    if not current_context.get("eligibleRoutes"):
        current_context = rendered_context
    if policy_revision != str(policy["revision"]):
        return fresh_approval(
            policy,
            axes,
            confidence,
            margin,
            current_context,
            "This approval preview is stale. Review the updated route before applying it.",
            recalibrated,
            embedding_elapsed_ms,
            embedding_input_count,
            llm_confidence,
            llm_elapsed_ms,
            calibrated_confidence,
            raw_confidence,
            was_override,
        )
    selection = choose_route(policy, rendered_context, axes)
    rendered = approval(
        policy,
        axes,
        confidence,
        margin,
        selection,
        rendered_context,
        embedding_elapsed_ms=embedding_elapsed_ms,
        embedding_input_count=embedding_input_count,
        llm_confidence=llm_confidence,
        llm_elapsed_ms=llm_elapsed_ms,
        calibrated_confidence=calibrated_confidence,
        raw_confidence=raw_confidence,
        was_override=was_override,
    )["interaction"]
    if (
        params.get("interactionId") != rendered["id"]
        or params.get("stateRevision") != rendered["stateRevision"]
        or not action_is_enabled(rendered["surface"], params)
    ):
        return fresh_approval(
            policy,
            axes,
            confidence,
            margin,
            current_context,
            "This approval preview is no longer valid. Review the updated route before applying it.",
            recalibrated,
            embedding_elapsed_ms,
            embedding_input_count,
            llm_confidence,
            llm_elapsed_ms,
            calibrated_confidence,
            raw_confidence,
            was_override,
        )
    selected = (params.get("action") or {}).get("id")
    if selected == "keep-current" or params.get("outcome") != "accepted":
        if raw_confidence is not None:
            record_approval_outcome(
                policy,
                raw_confidence,
                "override" if was_override else "rejected",
            )
        if recalibrated:
            record_recalibration(
                policy,
                "classification_override_rejected",
                axes,
                axes,
                selection,
            )
        return decision(
            policy,
            request["requestId"],
            axes,
            confidence,
            margin,
            selection,
            "keepCurrent",
            embedding_elapsed_ms=embedding_elapsed_ms,
            embedding_input_count=embedding_input_count,
            llm_confidence=llm_confidence,
            llm_elapsed_ms=llm_elapsed_ms,
            calibrated_confidence=calibrated_confidence,
            decision_status="override" if was_override else "rejected",
            used_route=current_context.get("currentRoute"),
        )
    values = params.get("values") or {}
    if selected == "submit-override":
        original_axes = axes
        axes = {
            "work_type": selected_option(
                values.get("work_type"),
                WORK_TYPES,
                axes["work_type"],
            ),
            "complexity": values.get("complexity", axes["complexity"]),
            "orchestration": values.get("orchestration", axes["orchestration"]),
            "risk": values.get("risk", axes["risk"]),
        }
        if (
            axes["work_type"] not in WORK_TYPES
            or axes["complexity"] not in COMPLEXITIES
            or axes["orchestration"] not in ORCHESTRATIONS
            or axes["risk"] not in RISKS
        ):
            return error_notice(
                policy, "Override values must be chosen from the offered choices."
            )
        selection = choose_route(policy, rendered_context, axes)
        updates = recalibrate_semantic_policy(
            policy,
            rendered_context.get("routerPrompt", ""),
            rendered_context["turn"]["scope"],
            axes,
        )
        record_recalibration(
            policy,
            "classification_override_submitted",
            original_axes,
            axes,
            selection,
        )
        record_diagnostic(
            {
                "event": "semantic_classifier_recalibrated",
                "recordedAtUnixSeconds": int(time.time()),
                "policyRevision": policy["revision"],
                "scope": rendered_context["turn"]["scope"],
                "updatedHeads": updates,
            }
        )
        if selection["route"] is None:
            record_recalibration(
                policy,
                "classification_override_rejected",
                axes,
                axes,
                selection,
            )
            return decision(
                policy,
                request["requestId"],
                axes,
                confidence,
                margin,
                selection,
                "keepCurrent",
                "No eligible ranked route was available.",
                embedding_elapsed_ms=embedding_elapsed_ms,
                embedding_input_count=embedding_input_count,
                llm_confidence=llm_confidence,
                llm_elapsed_ms=llm_elapsed_ms,
                calibrated_confidence=calibrated_confidence,
                decision_status="override",
                used_route=current_context.get("currentRoute"),
            )
        return approval(
            policy,
            axes,
            confidence,
            margin,
            selection,
            rendered_context,
            recalibrated=True,
            embedding_elapsed_ms=embedding_elapsed_ms,
            embedding_input_count=embedding_input_count,
            llm_confidence=llm_confidence,
            llm_elapsed_ms=llm_elapsed_ms,
            calibrated_confidence=calibrated_confidence,
            raw_confidence=raw_confidence,
            was_override=True,
        )
    if recalibrated:
        record_recalibration(
            policy,
            "classification_override_approved",
            axes,
            axes,
            selection,
        )
    if raw_confidence is not None:
        record_approval_outcome(
            policy,
            raw_confidence,
            "override" if was_override else "approved",
        )
    return decision(
        policy,
        request["requestId"],
        axes,
        confidence,
        margin,
        selection,
        "apply",
        embedding_elapsed_ms=embedding_elapsed_ms,
        embedding_input_count=embedding_input_count,
        llm_confidence=llm_confidence,
        llm_elapsed_ms=llm_elapsed_ms,
        calibrated_confidence=calibrated_confidence,
        decision_status="override" if was_override else "approved",
        used_route=selection["route"],
    )


def main():
    try:
        request = json.load(sys.stdin)
        if (
            request.get("protocol") != "xedoc.script/v1"
            or request.get("extension") != "model-router"
        ):
            raise ValueError("unsupported protocol or extension")
        policy = load_policy()
        method = request.get("method")
        if method == "settings.open":
            result = settings_open(request, policy)
        elif method == "interaction.respond":
            continuation = (request.get("params") or {}).get("continuation", "")
            result = (
                approval_response(request, policy)
                if continuation.startswith("approval:")
                else settings_response(request, policy)
            )
        elif method == "routing.decide":
            result = routing_decide(request, policy)
        elif method == "routing.state":
            result = routing_state(policy)
        elif method == "routing.classifier.respond":
            result = routing_classifier_response(request, policy)
        else:
            raise ValueError("unsupported method")
        response(request, result=result)
    except (
        OSError,
        RuntimeError,
        ValueError,
        KeyError,
        TypeError,
        AttributeError,
        subprocess.TimeoutExpired,
        json.JSONDecodeError,
    ) as error:
        request_id = locals().get("request", {}).get("requestId", "")
        record_diagnostic(
            {
                "event": "router_failure",
                "recordedAtUnixSeconds": int(time.time()),
                "error": str(error)[:256],
                "requestId": request_id,
            }
        )
        response(
            {"requestId": request_id},
            error={"code": "invalid_request", "message": str(error)[:256]},
        )


if __name__ == "__main__":
    main()
