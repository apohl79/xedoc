}


def load_policy():
    with POLICY_PATH.open(encoding="utf-8") as source:
        policy = json.load(source)
    if "semanticClassifier" not in policy:
        semantic_policy_path = (
            RUNTIME_SEMANTIC_POLICY_PATH
            if RUNTIME_SEMANTIC_POLICY_PATH.is_file()
            else SEMANTIC_POLICY_PATH
        )
        with semantic_policy_path.open(encoding="utf-8") as source:
            semantic_policy = json.load(source)
        policy["semanticClassifier"] = {
            "dimensions": semantic_policy["embedding"]["dimensions"],
            "minimumScore": semantic_policy["classifier"]["minimum_score"],
            "minimumMargin": semantic_policy["classifier"]["minimum_margin"],
            "axes": semantic_policy["axes"],
        }
        if isinstance(semantic_policy.get("scopeAxes"), dict):
            policy["semanticClassifier"]["scopeAxes"] = semantic_policy["scopeAxes"]
        if isinstance(semantic_policy.get("steeringAxes"), dict):
            policy["semanticClassifier"]["steeringAxes"] = semantic_policy[
                "steeringAxes"
            ]
        if isinstance(semantic_policy.get("calibration"), dict):
            policy["semanticClassifier"]["calibration"] = semantic_policy["calibration"]
        save_policy(policy)
    semantic = policy["semanticClassifier"]
    if "subagentOrchestration" not in semantic:
        semantic["subagentOrchestration"] = {"explicitPromptRequired": True}
        save_policy(policy)
    if "classifierRoute" not in policy:
        policy["classifierRoute"] = None
        save_policy(policy)
    if "approvalCalibration" not in policy:
        policy["approvalCalibration"] = {"minimumSamples": 10, "buckets": {}}
        save_policy(policy)
    elif "minimumSamples" not in policy["approvalCalibration"]:
        policy["approvalCalibration"]["minimumSamples"] = 10
        save_policy(policy)
    validate_policy(policy)
    return policy


def validate_policy(policy):
    presets = policy.get("confidencePresets")
    if not isinstance(presets, dict) or policy.get("confidence") not in presets:
        raise ValueError("policy selects an unknown confidence preset")
    for preset in presets.values():
        score = preset.get("minimumScore")
        margin = preset.get("minimumMargin")
        if (
            not isinstance(score, (int, float))
            or isinstance(score, bool)
            or not math.isfinite(score)
            or not 0.0 <= score <= 1.0
            or not isinstance(margin, (int, float))
            or isinstance(margin, bool)
            or not math.isfinite(margin)
            or not 0.0 <= margin <= 1.0
        ):
            raise ValueError(
                "policy confidence thresholds must be finite values from zero to one"
            )
    calibration = policy.get("approvalCalibration")
    if not isinstance(calibration, dict) or set(calibration) != {
        "minimumSamples",
        "buckets",
    }:
        raise ValueError("policy approval calibration is invalid")
    minimum_samples = calibration["minimumSamples"]
    buckets = calibration["buckets"]
    if (
        not isinstance(minimum_samples, int)
        or isinstance(minimum_samples, bool)
        or minimum_samples < 1
        or not isinstance(buckets, dict)
        or len(buckets) > 10
    ):
        raise ValueError("policy approval calibration buckets are invalid")
    for bucket, outcomes in buckets.items():
        if (
            not isinstance(bucket, str)
            or bucket not in {str(index) for index in range(10)}
            or not isinstance(outcomes, dict)
            or set(outcomes) != {"approved", "rejected", "override"}
            or any(
                not isinstance(count, int) or isinstance(count, bool) or count < 0
                for count in outcomes.values()
            )
        ):
            raise ValueError("policy approval calibration bucket is invalid")
    axes = policy.get("axes")
    if not isinstance(axes, list) or {axis.get("id") for axis in axes} != set(
        AXIS_VALUES
    ):
        raise ValueError("policy must define the four ranking axes")
    for axis in axes:
        expected = set(AXIS_VALUES[axis["id"]])
        classes = axis.get("classes")
        if (
            not isinstance(classes, list)
            or {item.get("id") for item in classes} != expected
        ):
            raise ValueError(f"policy axis {axis['id']} has invalid classes")
        for item in classes:
            if (
                not isinstance(item.get("points"), int)
                or isinstance(item.get("points"), bool)
                or item.get("points") < 0
                or item.get("minimumModelClass") not in CLASS_ORDER
                or item.get("maximumModelClass") not in CLASS_ORDER
                or CLASS_ORDER[item["minimumModelClass"]]
                > CLASS_ORDER[item["maximumModelClass"]]
            ):
                raise ValueError(
                    f"policy axis {axis['id']} has invalid ranking metadata"
                )
    semantic = policy.get("semanticClassifier")
    if (
        not isinstance(semantic, dict)
        or semantic.get("dimensions") != 384
        or not isinstance(semantic.get("axes"), list)
        or {axis.get("id") for axis in semantic["axes"]} != set(AXIS_VALUES)
    ):
        raise ValueError("policy semantic classifier is invalid")
    for axis in semantic["axes"]:
        if not isinstance(axis.get("classes"), list) or not axis["classes"]:
            raise ValueError(f"semantic axis {axis.get('id')} has no classes")
        for item in axis["classes"]:
            weights = item.get("weights")
            if (
                not isinstance(item.get("id"), str)
                or not isinstance(weights, list)
                or len(weights) != semantic["dimensions"]
                or any(
                    not isinstance(weight, (int, float))
                    or isinstance(weight, bool)
                    or not math.isfinite(weight)
                    for weight in weights
                )
            ):
                raise ValueError(f"semantic axis {axis['id']} has invalid weights")
    for scope, scoped_axes in semantic.get("scopeAxes", {}).items():
        if scope not in ("root", "subagent") or not isinstance(scoped_axes, dict):
            raise ValueError("policy semantic classifier has invalid scope axes")
        for axis_id, classes in scoped_axes.items():
            if axis_id not in AXIS_VALUES or not isinstance(classes, list):
                raise ValueError("policy semantic classifier has invalid scope classes")
            if {item.get("id") for item in classes} != {
                item["id"]
                for axis in semantic["axes"]
                if axis["id"] == axis_id
                for item in axis["classes"]
            }:
                raise ValueError("policy semantic classifier scope classes differ")
            for item in classes:
                weights = item.get("weights")
                if (
                    not isinstance(weights, list)
                    or len(weights) != semantic["dimensions"]
                    or any(
                        not isinstance(weight, (int, float))
                        or isinstance(weight, bool)
                        or not math.isfinite(weight)
                        for weight in weights
                    )
                ):
                    raise ValueError(
                        "policy semantic classifier has invalid scope weights"
                    )
    steering_axes = semantic.get("steeringAxes")
    if steering_axes is not None:
        if (
            not isinstance(steering_axes, dict)
            or set(steering_axes) != {"steering", "task"}
            or any(
                not isinstance(weights, list)
                or len(weights) != semantic["dimensions"]
                or any(
                    not isinstance(weight, (int, float)) or isinstance(weight, bool)
                    for weight in weights
                )
                for weights in steering_axes.values()
            )
        ):
            raise ValueError("policy semantic classifier has invalid steering axes")
    subagent_orchestration = semantic.get("subagentOrchestration")
    if subagent_orchestration is not None and (
        not isinstance(subagent_orchestration, dict)
        or not isinstance(
            subagent_orchestration.get("explicitPromptRequired"), bool
        )
    ):
        raise ValueError("policy subagent orchestration gate is invalid")
    ranking = policy.get("ranking")
    if (
        not isinstance(ranking, dict)
        or not isinstance(ranking.get("minimumScore"), int)
        or not isinstance(ranking.get("maximumScore"), int)
        or ranking["minimumScore"] > ranking["maximumScore"]
    ):
        raise ValueError("policy ranking score domain is invalid")
    classifier_route = policy.get("classifierRoute")
    if classifier_route is not None and valid_route_shape(classifier_route) is None:
        raise ValueError("policy classifier route is invalid")
    ladder = ranking.get("ladder")
    if not isinstance(ladder, list) or not ladder:
        raise ValueError("policy ranking ladder must not be empty")
    ranks = [entry.get("rank") for entry in ladder]
    if ranks != sorted(ranks) or len(ranks) != len(set(ranks)):
        raise ValueError("policy ranking ladder ranks must be unique and ordered")
    for entry in ladder:
        if (
            not isinstance(entry.get("rank"), int)
            or isinstance(entry.get("rank"), bool)
            or entry["rank"] < 1
            or entry.get("class") not in CLASS_ORDER
            or valid_route_shape(entry) is None
        ):
            raise ValueError("policy ranking ladder contains an invalid slot")


def save_policy(policy):
    destination = POLICY_PATH.parent
    fd, temporary = tempfile.mkstemp(
        prefix=f".{POLICY_PATH.name}.", dir=destination, text=True
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            json.dump(policy, out, indent=2, sort_keys=True)
            out.write("\n")
        os.replace(temporary, POLICY_PATH)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def record_diagnostic(record):
    encoded = json.dumps(record, separators=(",", ":"), sort_keys=True)
    encoded_size = len(encoded.encode("utf-8"))
    if encoded_size + 1 >= MAX_DIAGNOSTICS_BYTES:
        return
    try:
        if (
            DIAGNOSTICS_PATH.exists()
            and DIAGNOSTICS_PATH.stat().st_size + encoded_size + 1
            > MAX_DIAGNOSTICS_BYTES
        ):
            DIAGNOSTICS_PATH.unlink()
        fd = os.open(
            DIAGNOSTICS_PATH,
            os.O_WRONLY | os.O_APPEND | os.O_CREAT,
            0o600,
        )
        with os.fdopen(fd, "a", encoding="utf-8") as output:
            output.write(f"{encoded}\n")
    except OSError:
        pass


def prompt_preview(prompt):
    if not isinstance(prompt, str):
        return ""
    normalized = "".join(
        character if character.isprintable() else " " for character in prompt
    )
    normalized = " ".join(normalized.split())
    encoded = normalized.encode("utf-8")
    if len(encoded) <= MAX_PROMPT_PREVIEW_BYTES:
        return normalized
    prefix = encoded[: MAX_PROMPT_PREVIEW_BYTES - 3].decode(
        "utf-8", errors="ignore"
    )
    return f"{prefix}..."


def record_recalibration(policy, event, before, after, selection):
    route = selection["route"]
    record = {
        "event": event,
        "recordedAtUnixSeconds": int(time.time()),
        "policyRevision": policy["revision"],
        "before": before,
        "after": after,
        "ranking": {
            "score": selection["score"],
            "selectedRank": selection["selectedRank"],
            "targetRank": selection["targetRank"],
        },
    }
    if route is not None:
        record["route"] = {
            "providerId": route["providerId"],
            "model": route["model"],
            "reasoningEffort": route["reasoningEffort"],
        }
    record_diagnostic(record)


def semantic_class_matches(axis_id, class_id, selected):
    return (
        work_type_group(class_id) == selected
        if axis_id == "work_type"
        else class_id == selected
    )


def blend_semantic_weights(weights, embedding, prior_weight=64):
    return [
        (weight * prior_weight + value) / (prior_weight + 1)
        for weight, value in zip(weights, embedding)
    ]


def next_policy_revision(revision):
    if isinstance(revision, int) and not isinstance(revision, bool):
        return revision + 1
    if isinstance(revision, str) and revision:
        return f"{revision}-update-{time.time_ns()}"
    raise ValueError("policy revision must be a non-empty string or integer")


def recalibrate_semantic_policy(policy, prompt, scope, axes):
    embedding = semantic_embedding(prompt)
    semantic = policy["semanticClassifier"]
    updates = 0
    for axis in semantic["axes"]:
        selected = axes[axis["id"]]
        for candidate in axis["classes"]:
            if semantic_class_matches(axis["id"], candidate["id"], selected):
                candidate["weights"] = blend_semantic_weights(
                    candidate["weights"], embedding
                )
                updates += 1
    scope_axes = semantic.setdefault("scopeAxes", {})
    scoped = scope_axes.setdefault(scope, {})
    for axis in semantic["axes"]:
        candidates = scoped.setdefault(
            axis["id"],
            [
                {"id": candidate["id"], "weights": candidate["weights"]}
                for candidate in axis["classes"]
            ],
        )
        selected = axes[axis["id"]]
        for candidate in candidates:
            if semantic_class_matches(axis["id"], candidate["id"], selected):
                candidate["weights"] = blend_semantic_weights(
                    candidate["weights"], embedding
                )
                updates += 1
    semantic["feedbackUpdates"] = semantic.get("feedbackUpdates", 0) + updates
    policy["revision"] = next_policy_revision(policy["revision"])
    save_policy(policy)
    return updates


def record_routing_decision(
    policy,
    context,
    axes,
    similarity,
    margin,
    selection,
    mode,
    active,
    steering,
    disposition,
    llm_confidence=None,
    llm_elapsed_ms=None,
    calibrated_confidence=None,
):
    route = selection["route"]
    conversation = context.get("conversation") or {}
    recent_messages = conversation.get("recentMessages")
    record = {
        "event": "routing_decision",
        "recordedAtUnixSeconds": int(time.time()),
        "policyRevision": policy["revision"],
        "turn": {
            "scope": (context.get("turn") or {}).get("scope"),
            "active": active,
            "routeMutable": (context.get("turn") or {}).get("routeMutable"),
        },
        "mode": {
            "effective": mode,
            "sessionOverride": session_mode(context),
        },
        "conversation": {
            "recentMessageCount": (
                len(recent_messages) if isinstance(recent_messages, list) else 0
            ),
            "truncated": bool(conversation.get("truncated", False)),
        },
        "classification": axes,
        "classifier": "arctic-embed-xs",
        "confidence": {
            "score": similarity,
            "similarity": similarity,
            "margin": margin,
            "llmSelfRating": llm_confidence,
            "calibratedOverall": calibrated_confidence,
        },
        "timing": {"llmClassificationElapsedMs": llm_elapsed_ms},
        "selection": {
            "score": selection["score"],
            "selectedRank": selection["selectedRank"],
            "targetRank": selection["targetRank"],
        },
        "steering": steering,
        "disposition": disposition,
    }
    if route is not None:
        record["route"] = {
            "providerId": route["providerId"],
            "model": route["model"],
            "reasoningEffort": route["reasoningEffort"],
        }
    record_diagnostic(record)


def response(request, result=None, error=None):
    answer = {
        "protocol": "xedoc.script/v1",
        "requestId": request["requestId"],
    }
    if error is not None:
        answer["error"] = error
    else:
        answer["result"] = result
    json.dump(answer, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


def action(
    identifier,
    label=None,
    *,
    host_action=None,
    opens=None,
    value=None,
    bindings=None,
    context=None,
):
    result = {"id": identifier}
    if label is not None:
        result["label"] = label
    if host_action is not None:
        result["hostAction"] = host_action
    if opens is not None:
        result["opens"] = opens
    if value is not None:
        result["value"] = value
    if bindings:
        result["keyBindings"] = bindings
    if context is not None:
        result["context"] = context
    return result


def interaction(identifier, continuation, policy, surface, session_update=None):
    result = {
        "kind": "interaction",
        "interaction": {
            "id": identifier,
            "continuation": continuation,
            "stateRevision": str(policy["revision"]),
            "surface": surface,
        },
    }
    if session_update is not None:
        result["interaction"]["sessionUpdate"] = session_update
    return result


def menu(
    policy,
    title,
    items,
    subtitle=None,
    *,
    continuation="settings:root",
    session_update=None,
):
    surface = {"type": "menu", "title": title, "items": items}
    if subtitle:
        surface["subtitle"] = subtitle
    return interaction(
        "router-settings", continuation, policy, surface, session_update
    )


def session_mode(context):
    return (context.get("session") or {}).get("routerMode")


def supports_session_mode(context):
    return (context.get("session") or {}).get("supportsRouterMode", False)


def effective_mode(policy, context):
    return session_mode(context) or policy["mode"]


def root_menu(policy, context=None, conflict=None, session_update=None):
    context = context or {}
    subtitle = "Update routing settings and the policy."
    if conflict:
        subtitle = f"Settings conflict: {conflict} {subtitle}"
    items = [
        item(
            "mode",
            f"Mode: {policy['mode']}",
            "Change the shared routing default for all sessions.",
            "open-mode",
        )
    ]
    if supports_session_mode(context):
        current_session_mode = session_mode(context)
        label = (
            f"Session mode: {current_session_mode}"
            if current_session_mode
            else f"Session mode: shared default ({policy['mode']})"
        )
        items.append(
            item(
                "session-mode",
                label,
                "Override routing only for this current session.",
                "open-session-mode",
            )
        )
    items.extend(
        [
            item(
                "approval",
                f"Approval prompts: {policy['approval']}",
                "Choose when a route needs confirmation.",
                "open-approval",
            ),
            item(
                "feedback",
                f"Routing feedback: {'on' if policy['feedback'] else 'off'}",
                "Show script-provided classification and route details.",
                "toggle-feedback",
            ),
            item(
                "ab-arm",
                "Arm A/B test",
                "Arm the next eligible routing experiment.",
                "arm-ab",
                host_action="arm-ab",
            ),
            item(
                "ab-disable",
                "Disable A/B test",
                "Disable a pending routing experiment.",
                "disable-ab",
                host_action="disable-ab",
            ),
            item(
                "report",
                "Open routing report",
                "Open Xedoc's bounded local routing report.",
                "open-report",
                host_action="open-report",
            ),
            item(
                "policy",
                "Policy manager",
                "Tune similarity, model ladder, and reporting baseline.",
                "open-policy",
            ),
        ]
    )
    return menu(
        policy,
        "Model Router Settings",
        items,
        subtitle,
        session_update=session_update,
    )


def item(
    identifier,
    label,
    description,
    action_id,
    *,
    host_action=None,
    bindings=None,
    current=None,
):
    return {
        "id": identifier,
        "label": label,
        "action": action(
            action_id,
            host_action=host_action,
            bindings=bindings or ["enter"],
        ),
        **({"description": description} if description else {}),
        **({"current": True} if current else {}),
    }


def select_field(identifier, label, selected, options):
    return {
        "type": "select",
        "id": identifier,
        "label": label,
        "value": select_option_id(selected),
        "current": select_option_id(selected),
        "options": [
            (
                option
