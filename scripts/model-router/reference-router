def select_option_id(option):
    if option in WORK_TYPES:
        return option.split(":", 1)[0]
    return option


def selected_option(option_id, options, fallback):
    return next(
        (
            option
            for option in options
            if select_option_id(option) == option_id
        ),
        fallback,
    )


def form(
    policy,
    title,
    continuation,
    fields,
    submit_id,
    submit_label="Save",
    *,
    form_id=None,
    subtitle=None,
    cancel_action_id="back",
):
    surface = {
        "type": "form",
        "id": form_id or continuation,
        "title": title,
        "fields": fields,
        "submit": action(submit_id, submit_label, bindings=["enter"]),
        "cancel": action(cancel_action_id, "Back", bindings=["escape"]),
    }
    if subtitle is not None:
        surface["subtitle"] = subtitle
    return interaction(
        title.lower().replace(" ", "-"),
        continuation,
        policy,
        surface,
    )


def eligible(context):
    return context.get("eligibleRoutes", [])


def eligible_classifier_routes(context):
    return context.get("eligibleClassifierRoutes", [])


def route_label(route):
    if not route:
        return "Not set"
    return "{}/{}/{}".format(
        route["providerId"], route["model"], route["reasoningEffort"]
    )


def ladder(policy):
    return policy["ranking"]["ladder"]


def entry_route(entry):
    return {
        "providerId": entry["providerId"],
        "model": entry["model"],
        "reasoningEffort": entry["reasoningEffort"],
    }


def ladder_entry(policy, rank):
    return next((entry for entry in ladder(policy) if entry["rank"] == rank), None)


def matching_ladder_rank(policy, route):
    return next(
        (entry["rank"] for entry in ladder(policy) if entry_route(entry) == route),
        None,
    )


def policy_route_options(policy, context):
    available = {route_key(route) for route in offered_routes(context)}
    routes = []
    for entry in ladder(policy):
        route = entry_route(entry)
        if route not in routes:
            routes.append(route)
    return routes, available


def policy_route_id(route, routes):
    return f"route-{routes.index(route)}" if route in routes else None


def policy_select_field(identifier, label, value, options, description=None):
    field = {
        "type": "select",
        "id": identifier,
        "label": label,
        "value": value,
        "current": value,
        "options": options,
    }
    if description is not None:
        field["description"] = description
    return field


def policy_action_field(identifier, label, action_id):
    return {
        "type": "action",
        "id": identifier,
        "label": label,
