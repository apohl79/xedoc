def action_is_enabled(surface, params):
    selected = params.get("action") or {}
    action_id = selected.get("id")
    if not isinstance(action_id, str):
        return False
    outcome = params.get("outcome")
    kind = surface.get("type")
    if kind == "menu" and outcome == "accepted":
        if params.get("continuation") == "settings:policy" and action_id == "back":
            return True
        return any(
            item.get("disabled") is not True
            and (item.get("action") or {}).get("id") == action_id
            for item in surface.get("items", [])
        )
    if kind == "form":
        if outcome == "accepted":
            if (surface.get("submit") or {}).get("id") == action_id:
                return True
            return (
                not params.get("values")
                and any(
                    (field.get("action") or {}).get("id") == action_id
                    for field in surface.get("fields", [])
                    if field.get("type") == "action"
                )
            )
        if outcome == "cancelled":
            return (surface.get("cancel") or {}).get("id") == action_id
    if kind == "confirmation":
        if outcome == "accepted":
            return (
                any(
                    action.get("opens") is None and action.get("id") == action_id
                    for action in surface.get("actions", [])
                )
                or (surface.get("override") or {}).get("submit", {}).get("id")
                == action_id
            )
        if outcome == "cancelled":
            return (surface.get("override") or {}).get("cancel", {}).get(
                "id"
            ) == action_id
    return False


def settings_conflict(policy, context, message):
    return root_menu(policy, context, message)


def rendered_settings_action(policy, request):
    params = request.get("params") or {}
    continuation = params.get("continuation")
    rendered = settings_surface(policy, request.get("context") or {}, continuation)
    if rendered is None:
        return None, settings_conflict(
            policy, request.get("context") or {}, "This settings surface is no longer available."
        )
    interaction_data = rendered["interaction"]
    if (
        params.get("interactionId") != interaction_data["id"]
        or params.get("stateRevision") != interaction_data["stateRevision"]
    ):
        return None, settings_conflict(
            policy, request.get("context") or {}, "Settings changed before this action was submitted."
        )
    if not action_is_enabled(interaction_data["surface"], params):
        return None, settings_conflict(
            policy,
            request.get("context") or {},
            "That action is not enabled on the rendered settings surface.",
        )
    return (params.get("action") or {}).get("id"), None


def settings_response(request, policy):
    action_id, conflict = rendered_settings_action(policy, request)
    if conflict is not None:
        return conflict
    params = request.get("params") or {}
    values = params.get("values") or {}
    context = request.get("context", {})
    if action_id == "open-mode":
        return form(
            policy,
            "Routing mode",
            "settings:mode",
            [select_field("mode", "Mode", policy["mode"], MODES)],
            "set-mode",
        )
    if action_id == "open-session-mode":
        return form(
            policy,
            "Session routing mode",
            "settings:session-mode",
            [session_mode_field(policy, context)],
            "set-session-mode",
            subtitle="Choose a setting for this session only.",
        )
    if action_id == "set-mode":
        mode = values.get("mode")
        if mode not in MODES:
            return error_notice(policy, "Mode must be one of the offered choices.")
        update(policy, mode=mode)
        return root_menu(policy, context)
    if action_id == "set-session-mode":
        mode = values.get("mode")
        if mode != "default" and mode not in MODES:
            return error_notice(policy, "Session mode must be one of the offered choices.")
        updated_context = {
            **context,
            "session": {
                **(context.get("session") or {}),
                "routerMode": None if mode == "default" else mode,
            },
        }
        return root_menu(
            policy,
            updated_context,
            session_update={"routerMode": None if mode == "default" else mode},
        )
    if action_id == "open-approval":
        return form(
            policy,
            "Approval prompts",
            "settings:approval",
            [
                select_field(
                    "approval",
                    "Approval prompts",
                    policy["approval"],
                    approval_options(),
                ),
            ],
            "set-approval",
        )
    if action_id == "set-approval":
        approval = values.get("approval")
        if approval not in APPROVALS:
            return error_notice(policy, "Approval must be one of the offered choices.")
        update(policy, approval=approval)
        return root_menu(policy, context)
    if action_id == "toggle-feedback":
        update(policy, feedback=not policy["feedback"])
        return root_menu(policy, context)
    if action_id in ("arm-ab", "disable-ab", "open-report"):
        return root_menu(policy, context)
    if action_id == "open-policy":
        return policy_menu(policy, context)
    if action_id == "open-policy-ladder":
        return policy_ladder_form(policy, context)
    if action_id == "open-reporting-baseline":
        return settings_surface(
            policy, context, "settings:policy:reporting-baseline"
        )
    if action_id == "open-classifier-model":
        return settings_surface(
            policy, context, "settings:policy:classifier-model"
        )
    if action_id == "open-classifier-backend":
        return settings_surface(
            policy, context, "settings:policy:classifier-backend"
        )
    if action_id == "open-jev-model":
        return settings_surface(policy, context, "settings:policy:jev-model")
    if action_id == "open-jev-api-key":
        return settings_surface(policy, context, "settings:policy:jev-api-key")
    if action_id == "save-policy":
        confidence = values.get("confidence")
        if confidence not in policy["confidencePresets"]:
            return error_notice(
                policy, "Confidence must be one of the offered choices."
            )
        update(policy, confidence=confidence)
        return policy_menu(policy, context)
    if action_id == "set-reporting-baseline":
        routes, _ = policy_route_options(policy, context)
        route_by_id = {
            f"route-{index}": route for index, route in enumerate(routes)
        }
        baseline_id = values.get("reporting-baseline")
        if baseline_id == "none":
            baseline = None
        else:
            baseline = route_by_id.get(baseline_id)
            if baseline is None:
                return error_notice(
                    policy, "Choose a ladder route for the reporting baseline."
                )
        if baseline is not None and matching_ladder_rank(policy, baseline) is None:
            return error_notice(
                policy, "Choose a model-ladder route for the reporting baseline."
            )
        update(policy, reportingBaseline=baseline)
        return policy_menu(policy, context)
    if action_id == "set-classifier-model":
        routes = []
        for offered in eligible_classifier_routes(context):
            for effort in offered.get("reasoningEfforts", []):
                route = valid_route(
                    {
                        "providerId": offered.get("providerId"),
                        "model": offered.get("model"),
                        "reasoningEffort": effort,
                    },
                    eligible_classifier_routes(context),
                )
                if route:
                    routes.append(route)
        selected = values.get("classifier-model")
        if selected == "none":
            classifier_route = None
        elif isinstance(selected, str) and selected.startswith("route-"):
            try:
                classifier_route = routes[int(selected.removeprefix("route-"))]
            except (ValueError, IndexError):
                classifier_route = None
                return error_notice(
                    policy, "Choose a currently supported classifier model."
                )
        else:
            return error_notice(
                policy, "Choose a currently supported classifier model."
            )
        update(policy, classifierRoute=classifier_route)
        return policy_menu(policy, context)
    if action_id == "set-classifier-backend":
        backend = values.get("classifier-backend")
        if backend not in JEV_BACKENDS:
            return error_notice(policy, "Choose one of the offered classifiers.")
        update(
            policy,
            externalClassifier={
                "backend": backend,
                "model": (
                    (
                        policy["externalClassifier"]["model"]
                        if policy["externalClassifier"]["model"] in JEV_MODEL_OPTIONS
                        else JEV_MODEL_OPTIONS[0]
                    )
                    if backend == "jev"
                    else None
                ),
            },
            approvalCalibration={
                **policy["approvalCalibration"],
                "buckets": {},
            },
        )
        return policy_menu(policy, context)
    if action_id == "set-jev-model":
        model = values.get("jev-model")
        if model not in JEV_MODEL_OPTIONS:
            return error_notice(policy, "Choose one of the offered Jev models.")
        update(
            policy,
            externalClassifier={
                "backend": "jev",
                "model": model,
            },
            approvalCalibration={
                **policy["approvalCalibration"],
                "buckets": {},
            },
        )
        return policy_menu(policy, context)
    if action_id == "set-jev-api-key":
        return policy_menu(policy, context)
    if action_id == "save-policy-ladder":
        routes, _ = policy_route_options(policy, context)
        route_by_id = {
            f"route-{index}": route for index, route in enumerate(routes)
        }
        updated_ladder = copy.deepcopy(ladder(policy))
        for entry in updated_ladder:
            route = route_by_id.get(values.get(f"ladder-{entry['rank']}"))
            if route is None:
                return error_notice(
                    policy, f"Choose an eligible model route for rank {entry['rank']}."
                )
            entry.update(route)
        update(
            policy,
            ranking={
                **policy["ranking"],
                "ladder": updated_ladder,
            },
        )
        return policy_menu(policy, context)
    if action_id == "back-policy":
        return policy_menu(policy, context)
    if action_id == "back":
        return root_menu(policy, context)
    return error_notice(policy, "Unknown settings action.")


