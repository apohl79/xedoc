#!/usr/bin/env python3

from __future__ import annotations

import argparse
from contextlib import contextmanager
import getpass
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from typing import cast

from session_script_sdk import RpcError
from session_script_sdk import SessionScriptClient


DEFAULT_XEDOC_HOME = Path.home() / ".xedoc"
REMOTE_AGENT_ROLES = {"coordinator", "managed"}
REMOTE_AGENT_WORKSPACE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}\Z")
REMOTE_AGENT_DEFAULT_LIMITS: dict[str, int] = {
    "max_attached_sessions": 8,
    "max_message_bytes": 16_384,
    "max_result_bytes": 65_536,
    "max_wait_seconds": 120,
    "max_discovery_seconds": 10,
    "audit_retention_days": 90,
}


class AppServerError(RuntimeError):
    def __init__(self, message: str, code: int | None = None) -> None:
        self.code = code
        super().__init__(message)


class AppServerClient:
    def __init__(self, socket_path: Path, timeout: float, client_name: str) -> None:
        try:
            self.client = SessionScriptClient.connect_unix_socket(socket_path, timeout)
        except RpcError as error:
            raise AppServerError(str(error), error.code) from error
        self.client_name = client_name

    def __enter__(self) -> "AppServerClient":
        try:
            self.client.initialize(
                self.client_name,
                "Xedoc session control",
                "0.1.0",
            )
        except RpcError as error:
            raise AppServerError(str(error), error.code) from error
        return self

    def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> None:
        self.client.close()

    def request(self, method: str, params: dict[str, object]) -> dict[str, object]:
        try:
            return cast(dict[str, object], self.client.request(method, params))
        except RpcError as error:
            raise AppServerError(str(error), error.code) from error


def default_socket_path(experimental: bool) -> Path:
    xedoc_home = Path(os.environ.get("XEDOC_HOME", DEFAULT_XEDOC_HOME))
    filename = "experimental.sock" if experimental else "app-server-control.sock"
    return xedoc_home / "app-server-control" / filename


def is_experimental_invocation() -> bool:
    return Path(sys.argv[0]).name == "xedoc-session-experimental"


def managed_xedoc_binary() -> Path:
    binary = Path(sys.argv[0]).resolve().with_name("xedoc")
    if not binary.is_file():
        raise AppServerError(
            "cannot find the Xedoc binary beside this session-control script"
        )
    return binary


def run_daemon_command(experimental: bool, action: str) -> None:
    binary = managed_xedoc_binary()
    command_name = "xedoc-experimental" if experimental else "xedoc"
    try:
        result = subprocess.run(
            [command_name, "app-server", "daemon", action],
            executable=binary,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AppServerError(f"could not {action} the managed app-server") from error
    if result.returncode != 0:
        raise AppServerError(f"could not {action} the managed app-server")


def remote_agent_pairing_command(
    action: str, peer_host_id: str | None = None
) -> dict[str, object]:
    binary = managed_xedoc_binary().with_name("xedoc-remote-agentd")
    if not binary.is_file():
        raise AppServerError("cannot find xedoc-remote-agentd beside the Xedoc binary")
    command = [str(binary), "pairings", action]
    if peer_host_id is not None:
        command.extend(("--peer-host-id", peer_host_id))
    try:
        result = subprocess.run(
            command,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AppServerError("could not contact the local remote-agent broker") from error
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise AppServerError("remote-agent broker returned an invalid response") from error
    if result.returncode != 0 or not isinstance(response, dict):
        raise AppServerError("remote-agent pairing command failed")
    return cast(dict[str, object], response)


def remote_agent_pairings(args: argparse.Namespace) -> dict[str, object]:
    if args.approve is not None:
        return remote_agent_pairing_command("approve", args.approve)
    if args.reject is not None:
        return remote_agent_pairing_command("reject", args.reject)
    requests = remote_agent_pairing_command("list")
    data = as_object_list(requests.get("data", []), "pairing request")
    if not data:
        return requests
    if not sys.stdin.isatty():
        raise AppServerError(
            "pending pairings require an interactive terminal; pass --approve or --reject"
        )
    choices: list[tuple[str, str]] = []
    for request in data:
        host_id = request.get("hostId")
        role = request.get("role")
        endpoint = request.get("endpoint")
        if not isinstance(host_id, str) or not isinstance(role, str) or not isinstance(
            endpoint, str
        ):
            raise AppServerError("remote-agent broker returned an invalid pairing request")
        choices.append((host_id, f"{host_id} — {role} at {endpoint}"))
    peer_host_id = prompt_choice(
        "Incoming pairing requests (use ↑/↓ and Enter):", choices
    )
    decision = prompt_choice(
        "Pairing decision (use ↑/↓ and Enter):",
        [("approve", "Approve"), ("reject", "Reject")],
    )
    return remote_agent_pairing_command(decision, peer_host_id)


def remote_agent_enrollment_command(
    action: str,
    *,
    peer_host_id: str | None = None,
    fingerprint: str | None = None,
    role: str | None = None,
    code: str | None = None,
    endpoints: list[str] | None = None,
    ttl_seconds: int | None = None,
) -> dict[str, object]:
    binary = managed_xedoc_binary().with_name("xedoc-remote-agentd")
    if not binary.is_file():
        raise AppServerError("cannot find xedoc-remote-agentd beside the Xedoc binary")
    command = [str(binary), "enrollment", action]
    if peer_host_id is not None:
        command.extend(("--peer-host-id", peer_host_id))
    if fingerprint is not None:
        command.extend(("--fingerprint", fingerprint))
    if role is not None:
        command.extend(("--role", role))
    if action == "discover" and endpoints:
        for endpoint in endpoints:
            command.extend(("--endpoint", endpoint))
    if ttl_seconds is not None:
        command.extend(("--ttl-seconds", str(ttl_seconds)))
    try:
        result = subprocess.run(
            command,
            check=False,
            input=f"{code}\n" if code is not None else None,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=40,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AppServerError("could not contact the local remote-agent broker") from error
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise AppServerError(
            "remote-agent enrollment command failed: "
            f"{result.stderr.strip()[:300] or 'no output'}"
        ) from error
    if result.returncode != 0 or not isinstance(response, dict):
        raise AppServerError("remote-agent enrollment command failed")
    return cast(dict[str, object], response)


SSH_ENROLLMENT_TTL_SECONDS = 300
# The remote shell is a login shell so PATH matches an interactive session; the
# default install locations cover hosts where the binary is not on PATH.
SSH_ENROLLMENT_SCRIPT = (
    "for b in xedoc-remote-agentd "
    '"$HOME/.xedoc/packages/standalone/current/bin/xedoc-remote-agentd" '
    '"$HOME/.xedoc/packages/standalone/experimental/bin/xedoc-remote-agentd"; do '
    'if command -v "$b" >/dev/null 2>&1; then '
    f'exec "$b" enrollment create --ttl-seconds {SSH_ENROLLMENT_TTL_SECONDS}; fi; done; '
    "exit 127"
)


def ssh_target_for(candidate: dict[str, object], override: str | None) -> str | None:
    if override:
        return override
    endpoint = candidate.get("endpoint")
    if not isinstance(endpoint, str):
        return None
    host = endpoint.split("://", 1)[-1].rsplit(":", 1)[0].strip("[]")
    return host or None


def local_ssh_hint(host_id: object) -> tuple[str, list[str]] | None:
    """Read the SSH settings a local test harness registered for a peer.

    The Docker harness publishes its peer's sshd on a loopback port and writes
    the destination next to the local discovery registrations. Only a private
    directory owned by this user is trusted, and only the options below are
    accepted, so the hint cannot add arbitrary ssh behaviour.
    """

    if not isinstance(host_id, str) or not re.fullmatch(r"[A-Za-z0-9_]+", host_id):
        return None
    directory = Path(tempfile.gettempdir()) / f"xedoc-remote-agent-discovery-{os.getuid()}"
    try:
        status = directory.stat()
        if status.st_uid != os.getuid() or status.st_mode & 0o077:
            return None
        value = json.loads((directory / f"{host_id}.ssh").read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict):
        return None
    target = value.get("target")
    options = value.get("options")
    if (
        not isinstance(target, str)
        or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@-]*", target)
        or not isinstance(options, list)
        or len(options) > 4
        or not all(
            isinstance(option, str)
            and re.fullmatch(r"(Port|UserKnownHostsFile)=\S+", option)
            for option in options
        )
    ):
        return None
    return target, cast(list[str], options)


def ssh_enrollment_unavailable(reason: str) -> None:
    # The reason may carry text from the remote side; keep it to one printable line.
    printable = "".join(character for character in reason if character.isprintable())
    print(
        f"SSH enrollment unavailable ({printable[:200]}); asking for the code.",
        file=sys.stderr,
    )


def remote_agent_ssh_enrollment_code(
    candidate: dict[str, object],
    ssh_target: str | None,
    ssh_options: list[str] | None = None,
) -> str | None:
    """Ask the managed host for a short-lived enrollment code over SSH.

    SSH proves the coordinator's user may log in to the managed host's account,
    so no code has to be typed. Host keys are verified by ssh itself and prompts
    are disabled, so any failure returns None and the caller asks for the code.
    """

    if ssh_target is None and not ssh_options:
        hint = local_ssh_hint(candidate.get("hostId"))
        if hint is not None:
            ssh_target, ssh_options = hint
    target = ssh_target_for(candidate, ssh_target)
    if target is None or target.startswith("-"):
        ssh_enrollment_unavailable("no usable SSH target")
        return None
    if shutil.which("ssh") is None:
        ssh_enrollment_unavailable("ssh is not installed")
        return None
    try:
        result = subprocess.run(
            [
                "ssh",
                "-T",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=5",
                *(
                    argument
                    for option in ssh_options or []
                    for argument in ("-o", option)
                ),
                "--",
                target,
                f"sh -lc '{SSH_ENROLLMENT_SCRIPT}'",
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        ssh_enrollment_unavailable(f"{target}: {error}")
        return None
    if result.returncode != 0:
        lines = result.stderr.strip().splitlines()
        ssh_enrollment_unavailable(
            f"{target}: {lines[-1] if lines else f'exit status {result.returncode}'}"
        )
        return None
    try:
        issued = json.loads(result.stdout)
    except json.JSONDecodeError:
        ssh_enrollment_unavailable(f"{target}: unexpected output")
        return None
    code = issued.get("code") if isinstance(issued, dict) else None
    if (
        not isinstance(code, str)
        or issued.get("hostId") != candidate.get("hostId")
        or issued.get("fingerprint") != candidate.get("fingerprint")
    ):
        # The login landed on a different host or account than the one discovered.
        ssh_enrollment_unavailable(f"{target} is not the discovered host")
        return None
    print(
        f"Obtained a one-time enrollment code from {target} over SSH.",
        file=sys.stderr,
    )
    return code


def remote_agent_enroll(args: argparse.Namespace) -> dict[str, object]:
    discovered = remote_agent_enrollment_command("discover", endpoints=args.endpoint)
    candidates = sorted(
        as_object_list(discovered.get("data", []), "discovered host"),
        key=lambda candidate: cast(str, candidate.get("hostId", "")),
    )
    hosts = [
        candidate
        for candidate in candidates
        if candidate.get("role") in REMOTE_AGENT_ROLES
        and isinstance(candidate.get("status"), str)
        and isinstance(candidate.get("hostId"), str)
        and isinstance(candidate.get("fingerprint"), str)
        and isinstance(candidate.get("endpoint"), str)
    ]
    if not hosts:
        raise AppServerError("no pairable or paired hosts were discovered")
    if args.host_id is None:
        if not sys.stdin.isatty():
            raise AppServerError(
                "remote-host enrollment requires an interactive terminal; "
                "pass --host-id and --fingerprint"
            )
        choices = [
            (
                cast(str, candidate["hostId"]),
                f"{candidate.get('hostname') or candidate['hostId']} "
                f"({candidate['hostId']}) — {candidate['endpoint']} — "
                f"{candidate['role']} — {candidate['status']}",
            )
            for candidate in hosts
        ]
        host_id = prompt_choice(
            "Remote host (host ID — IP:port — type — pairing status; use ↑/↓ and Enter):",
            choices,
        )
        candidate = next(
            candidate for candidate in hosts if candidate["hostId"] == host_id
        )
    else:
        host_id = args.host_id
        candidate = next(
            (candidate for candidate in hosts if candidate["hostId"] == host_id), None
        )
        if candidate is None:
            raise AppServerError(
                f"remote host {host_id!r} was not discovered as pairable or paired"
            )
        fingerprint = args.fingerprint
        if fingerprint is not None and fingerprint != candidate["fingerprint"]:
            raise AppServerError(
                f"remote host {host_id!r} was not discovered with the requested "
                "fingerprint"
            )
    fingerprint = cast(str, candidate["fingerprint"])
    role = cast(str, candidate["role"])
    status = cast(str, candidate["status"])
    if status == "paired":
        decision = prompt_choice(
            f"Unpair {host_id} (use ↑/↓ and Enter):",
            [("unpair", "Unpair"), ("cancel", "Cancel")],
        )
        if decision == "cancel":
            return {"hostId": host_id, "status": "unchanged"}
        return remote_agent_enrollment_command("unpair", peer_host_id=host_id)
    if status != "unpaired":
        raise AppServerError(
            f"remote host {host_id!r} is {status!r}; only unpaired hosts can pair"
        )
    if role == "coordinator":
        return remote_agent_enrollment_command(
            "pair",
            peer_host_id=host_id,
            fingerprint=fingerprint,
            role=role,
        )
    code = (
        None
        if args.no_ssh
        else remote_agent_ssh_enrollment_code(
            candidate, args.ssh_target, args.ssh_option
        )
    )
    if code is None:
        try:
            code = getpass.getpass("Managed-host enrollment code: ").strip()
        except (EOFError, KeyboardInterrupt) as error:
            raise AppServerError("managed-host enrollment was cancelled") from error
    if not code:
        raise AppServerError("managed-host enrollment code is required")
    remembered = remote_agent_enrollment_command(
        "remember",
        peer_host_id=host_id,
        fingerprint=fingerprint,
        code=code,
    )
    pairing = remote_agent_enrollment_command(
        "pair",
        peer_host_id=host_id,
        fingerprint=fingerprint,
        role=role,
    )
    return {"enrollment": remembered, "pairing": pairing}


def write_remote_agent_bootstrap(socket_path: Path, experimental: bool) -> None:
    xedoc_home = Path(os.environ.get("XEDOC_HOME", DEFAULT_XEDOC_HOME))
    remote_agent_directory = xedoc_home / "remote-agent"
    remote_agent_directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    remote_agent_directory.chmod(0o700)
    socket_directory = socket_path.parent.resolve()
    bootstrap_name = "bootstrap-experimental.toml" if experimental else "bootstrap.toml"
    descriptor, temporary_path = tempfile.mkstemp(
        prefix=".bootstrap.", dir=remote_agent_directory
    )
    try:
        os.chmod(temporary_path, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as file:
            file.write(f'controller = "unix://{socket_directory}/{socket_path.name}"\n')
        Path(temporary_path).replace(remote_agent_directory / bootstrap_name)
    except OSError as error:
        try:
            os.close(descriptor)
        except OSError:
            pass
        Path(temporary_path).unlink(missing_ok=True)
        raise AppServerError("could not write remote-agent controller bootstrap") from error


def build_turn_start_params(
    thread_id: str, prompt: str, client_message_id: str | None
) -> dict[str, object]:
    params: dict[str, object] = {
        "threadId": thread_id,
        "input": [{"type": "text", "text": prompt}],
    }
    if client_message_id is not None:
        params["clientUserMessageId"] = client_message_id
    return params


def build_turn_steer_params(
    thread_id: str,
    turn_id: str,
    prompt: str,
    client_message_id: str | None,
) -> dict[str, object]:
    params: dict[str, object] = {
        "threadId": thread_id,
        "input": [{"type": "text", "text": prompt}],
        "expectedTurnId": turn_id,
    }
    if client_message_id is not None:
        params["clientUserMessageId"] = client_message_id
    return params


def as_object(value: object, label: str) -> dict[str, object]:
    if not isinstance(value, dict):
        raise AppServerError(f"app-server returned an invalid {label} object")
    return cast(dict[str, object], value)


def as_object_list(value: object, label: str) -> list[dict[str, object]]:
    if not isinstance(value, list) or not all(isinstance(item, dict) for item in value):
        raise AppServerError(f"app-server returned an invalid {label} list")
    return [cast(dict[str, object], item) for item in value]


def list_sessions(client: AppServerClient) -> list[dict[str, object]]:
    loaded = client.request("thread/loaded/list", {})
    thread_ids = loaded.get("data", [])
    if not isinstance(thread_ids, list) or not all(
        isinstance(thread_id, str) for thread_id in thread_ids
    ):
        raise AppServerError("app-server returned invalid loaded thread ids")

    sessions: list[dict[str, object]] = []
    for thread_id in thread_ids:
        response = client.request(
            "thread/read", {"threadId": thread_id, "includeTurns": False}
        )
        thread = as_object(response.get("thread"), "thread")
        sessions.append(
            {
                "id": thread.get("id", thread_id),
                "name": thread.get("name"),
                "cwd": thread.get("cwd"),
                "status": thread.get("status"),
                "canAcceptDirectInput": thread.get("canAcceptDirectInput"),
            }
        )
    return sessions


def list_running_turns(
    client: AppServerClient, thread_id: str
) -> list[dict[str, object]]:
    response = client.request(
        "thread/read", {"threadId": thread_id, "includeTurns": True}
    )
    thread = as_object(response.get("thread"), "thread")
    turns = as_object_list(thread.get("turns", []), "turn")
    return [
        {
            "id": turn.get("id"),
            "status": turn.get("status"),
            "startedAt": turn.get("startedAt"),
        }
        for turn in turns
        if turn.get("status") == "inProgress"
    ]


def resume_thread(client: AppServerClient, thread_id: str) -> dict[str, object]:
    response = client.request("thread/resume", {"threadId": thread_id})
    return as_object(response.get("thread"), "thread")


def start_turn(
    client: AppServerClient,
    thread_id: str,
    prompt: str,
    client_message_id: str | None,
) -> dict[str, object]:
    resume_thread(client, thread_id)
    return client.request(
        "turn/start", build_turn_start_params(thread_id, prompt, client_message_id)
    )


def steer_turn(
    client: AppServerClient,
    thread_id: str,
    turn_id: str,
    prompt: str,
    client_message_id: str | None,
) -> dict[str, object]:
    resume_thread(client, thread_id)
    return client.request(
        "turn/steer",
        build_turn_steer_params(thread_id, turn_id, prompt, client_message_id),
    )


def send_turn(
    client: AppServerClient,
    thread_id: str,
    prompt: str,
    client_message_id: str | None,
) -> dict[str, object]:
    thread = resume_thread(client, thread_id)
    turns = as_object_list(thread.get("turns", []), "turn")
    active_turns = [turn for turn in turns if turn.get("status") == "inProgress"]
    if len(active_turns) > 1:
        raise AppServerError(f"thread {thread_id} has multiple active turns")
    if active_turns:
        active_turn_id = active_turns[0].get("id")
        if not isinstance(active_turn_id, str):
            raise AppServerError("app-server returned an invalid active turn id")
        return client.request(
            "turn/steer",
            build_turn_steer_params(
                thread_id, active_turn_id, prompt, client_message_id
            ),
        )
    return client.request(
        "turn/start", build_turn_start_params(thread_id, prompt, client_message_id)
    )


def configured_remote_agent_role(value: object) -> str | None:
    if not isinstance(value, dict):
        return None
    role = value.get("role")
    if isinstance(role, str) and role in REMOTE_AGENT_ROLES:
        return role
    return None


def remote_agent_config(client: AppServerClient) -> object:
    response = client.request("config/read", {"includeLayers": True})
    config = as_object(response.get("config"), "config")
    return config.get("remote_agent")


def prompt_value(label: str) -> str:
    try:
        return input(label).strip()
    except EOFError as error:
        raise AppServerError("remote-agent configuration was cancelled") from error


@contextmanager
def terminal_input():
    if os.name == "nt":
        yield
        return

    import termios
    import tty

    file_descriptor = sys.stdin.fileno()
    settings = termios.tcgetattr(file_descriptor)
    try:
        tty.setcbreak(file_descriptor)
        yield
    finally:
        termios.tcsetattr(file_descriptor, termios.TCSADRAIN, settings)


def read_terminal_key() -> str:
    if os.name == "nt":
        import msvcrt

        key = msvcrt.getwch()
        if key in {"\x00", "\xe0"}:
            return {
                "H": "up",
                "P": "down",
                "K": "left",
                "M": "right",
            }.get(msvcrt.getwch(), "")
        return {
            "\r": "enter",
            "\n": "enter",
            "\x03": "cancel",
            "\x04": "cancel",
        }.get(key, key)

    key = sys.stdin.read(1)
    if key == "\x1b":
        sequence = sys.stdin.read(2)
        return {
            "[A": "up",
            "[B": "down",
            "[C": "right",
            "[D": "left",
        }.get(sequence, "cancel")
    return {
        "\r": "enter",
        "\n": "enter",
        "\x03": "cancel",
        "\x04": "cancel",
    }.get(key, key)


def prompt_choice(
    label: str, options: list[tuple[str, str]], default_index: int = 0
) -> str:
    if not options:
        raise AppServerError("choice prompt has no options")
    if not 0 <= default_index < len(options):
        raise AppServerError("choice prompt has an invalid default")

    selected_index = default_index
    rendered_lines = 0

    def render() -> None:
        nonlocal rendered_lines
        if rendered_lines:
            sys.stdout.write(f"\x1b[{rendered_lines}A")
        for index, (_, description) in enumerate(options):
            marker = "›" if index == selected_index else " "
            sys.stdout.write(f"\r\x1b[2K{marker} {description}\n")
        sys.stdout.flush()
        rendered_lines = len(options)

    sys.stdout.write(f"{label}\n")
    render()
    try:
        with terminal_input():
            while True:
                key = read_terminal_key()
                if key == "up":
                    selected_index = (selected_index - 1) % len(options)
                    render()
                elif key == "down":
                    selected_index = (selected_index + 1) % len(options)
                    render()
                elif key == "enter":
                    sys.stdout.write("\n")
                    return options[selected_index][0]
                elif key == "cancel":
                    raise AppServerError(
                        "remote-agent configuration was cancelled"
                    )
    except KeyboardInterrupt as error:
        raise AppServerError("remote-agent configuration was cancelled") from error
    finally:
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()


def prompt_yes_no(label: str) -> bool:
    return (
        prompt_choice(label, [("yes", "Yes"), ("no", "No")], default_index=1)
        == "yes"
    )


def canonical_workspace_root(value: str) -> Path:
    try:
        root = Path(value).expanduser().resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        raise AppServerError(
            "workspace root must exist and resolve to a canonical path"
        ) from error
    if not root.is_dir() or not os.access(root, os.R_OK | os.X_OK):
        raise AppServerError(f"workspace root is not an accessible directory: {root}")
    return root


def prompt_role() -> str:
    return prompt_choice(
        "Remote-agent role (use ↑/↓ and Enter):",
        [
            ("coordinator", "Coordinator — manages peers"),
            ("managed", "Managed — accepts coordinators"),
        ],
    )


def prompt_workspaces() -> dict[str, str]:
    workspaces: dict[str, str] = {}
    roots: set[Path] = set()
    print(
        "A workspace ID is a local label used by remote clients to select a "
        "configured workspace. It is not a ChatGPT or OpenAI workspace ID; "
        "for example, use `codex`."
    )
    while True:
        workspace_id = prompt_value("Workspace ID: ")
        if not REMOTE_AGENT_WORKSPACE_ID.fullmatch(workspace_id):
            print(
                "Workspace ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,63}.",
                file=sys.stderr,
            )
            continue
        if workspace_id in workspaces:
            print("Workspace ID is already configured.", file=sys.stderr)
            continue
        try:
            root = canonical_workspace_root(prompt_value("Workspace root: "))
        except AppServerError as error:
            print(error, file=sys.stderr)
            continue
        if root in roots:
            print(
                "Workspace root duplicates an existing canonical root.", file=sys.stderr
            )
            continue
        workspaces[workspace_id] = str(root)
        roots.add(root)
        if len(workspaces) >= 128 or not prompt_yes_no("Add another workspace"):
            return workspaces


def enable_yolo_mode(client: AppServerClient) -> None:
    client.request(
        "config/value/write",
        {
            "keyPath": "approval_policy",
            "value": "never",
            "mergeStrategy": "replace",
        },
    )
    client.request(
        "config/value/write",
        {
            "keyPath": "sandbox_mode",
            "value": "danger-full-access",
            "mergeStrategy": "replace",
        },
    )


def prompt_coordinator_yolo_mode() -> bool:
    return (
        prompt_choice(
            "Enable YOLO mode for this coordinator (use ↑/↓ and Enter):",
            [
                ("enabled", "Enable YOLO — run tasks without confirmation prompts"),
                ("disabled", "Keep current approval and sandbox settings"),
            ],
            default_index=1,
        )
        == "enabled"
    )


def configure_remote_agent(
    client: AppServerClient, reconfigure: bool
) -> dict[str, object]:
    existing = remote_agent_config(client)

    existing_role = configured_remote_agent_role(existing)
    if existing_role is not None:
        if not reconfigure:
            if existing_role == "managed":
                enable_yolo_mode(client)
            return {
                "status": "alreadyConfigured",
                "role": existing_role,
                "yoloMode": existing_role == "managed",
            }
    elif reconfigure:
        raise AppServerError("--reconfigure requires an existing remote_agent role")
    if not sys.stdin.isatty():
        raise AppServerError(
            "remote-agent configuration requires an interactive terminal; "
            "run xedoc-session remote-agent-configure from a terminal"
        )

    role = prompt_role()
    workspaces = prompt_workspaces()
    yolo_mode = role == "managed" or prompt_coordinator_yolo_mode()
    if role == "managed":
        print(
            "Managed hosts auto-accept only coordinators that present the "
            "one-time enrollment code issued after setup. Pairing alone grants "
            "no workspace or session access; the coordinator must add explicit grants. "
            "Managed remote tasks always run in YOLO mode."
        )
    value: dict[str, object] = {
        "role": role,
        "workspaces": workspaces,
        "limits": REMOTE_AGENT_DEFAULT_LIMITS,
    }
    client.request(
        "config/value/write",
        {
            "keyPath": "remote_agent",
            "value": value,
            "mergeStrategy": "replace",
        },
    )
    if yolo_mode:
        enable_yolo_mode(client)
    return {
        "status": "configured",
        "role": role,
        "workspaceCount": len(workspaces),
        "yoloMode": yolo_mode,
        "pairingMode": (
            "automaticWithEnrollmentCode"
            if role == "managed"
            else "approvalRequired"
        ),
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Inspect and send prompts to sessions in a local Xedoc app-server."
    )
    parser.add_argument(
        "--socket",
        type=Path,
        help="App-server Unix socket path.",
    )
    parser.add_argument(
        "--experimental",
        action="store_true",
        help="Use the experimental managed app-server target.",
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=30.0,
        help="Socket timeout in seconds.",
    )
    parser.add_argument(
        "--client-name",
        default="xedoc-session",
        help="Client name sent during app-server initialization.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("sessions", help="List loaded sessions.")

    turns_parser = subparsers.add_parser(
        "turns", help="List running turns for a thread."
    )
    turns_parser.add_argument("thread_id")

    start_parser = subparsers.add_parser(
        "start", help="Send a prompt, steering an active turn when available."
    )
    start_parser.add_argument("thread_id")
    start_parser.add_argument("prompt")
    start_parser.add_argument("--client-message-id")

    steer_parser = subparsers.add_parser("steer", help="Send a turn/steer prompt.")
    steer_parser.add_argument("thread_id")
    steer_parser.add_argument("turn_id", help="Expected active turn id.")
    steer_parser.add_argument("prompt")
    steer_parser.add_argument("--client-message-id")

    remote_agent_parser = subparsers.add_parser(
        "remote-agent-configure",
        help="Interactively configure host-wide remote-agent settings.",
    )
    remote_agent_parser.add_argument(
        "--reconfigure",
        action="store_true",
        help="Replace an existing remote_agent configuration.",
    )
    remote_agent_parser.add_argument(
        "--experimental",
        action="store_true",
        default=argparse.SUPPRESS,
        help="Use the experimental managed app-server target.",
    )
    pairings_parser = subparsers.add_parser(
        "remote-agent-pairings",
        help="Review incoming coordinator pairing requests.",
    )
    pairings_decision = pairings_parser.add_mutually_exclusive_group()
    pairings_decision.add_argument(
        "--approve",
        metavar="HOST_ID",
        help="Approve one incoming pairing request.",
    )
    pairings_decision.add_argument(
        "--reject",
        metavar="HOST_ID",
        help="Reject one incoming pairing request.",
    )
    enroll_parser = subparsers.add_parser(
        "remote-agent-enroll",
        help="List discovered hosts and pair or unpair one with arrow-key navigation.",
    )
    enroll_parser.add_argument(
        "--host-id",
        help="Remote host ID; omit to select with arrow keys.",
    )
    enroll_parser.add_argument(
        "--fingerprint",
        help="Expected host fingerprint when pairing non-interactively.",
    )
    enroll_parser.add_argument(
        "--endpoint",
        action="append",
        default=[],
        metavar="HOST:UDPPORT",
        help="Direct discovery destination; repeatable.",
    )
    enroll_parser.add_argument(
        "--ssh-target",
        metavar="[USER@]HOST",
        help="SSH destination used to obtain a managed host's enrollment code.",
    )
    enroll_parser.add_argument(
        "--ssh-option",
        action="append",
        metavar="KEY=VALUE",
        help="Extra ssh -o option, such as Port=2222; repeatable.",
    )
    enroll_parser.add_argument(
        "--no-ssh",
        action="store_true",
        help="Always ask for the enrollment code instead of trying SSH.",
    )
    return parser


def configure_remote_agent_with_lifecycle(
    args: argparse.Namespace,
) -> dict[str, object]:
    try:
        with AppServerClient(args.socket, args.timeout, args.client_name) as client:
            result = configure_remote_agent(client, args.reconfigure)
    except OSError:
        run_daemon_command(args.experimental, "start")
        with AppServerClient(args.socket, args.timeout, args.client_name) as client:
            result = configure_remote_agent(client, args.reconfigure)
    write_remote_agent_bootstrap(args.socket, args.experimental)
    run_daemon_command(args.experimental, "restart")
    if result.get("role") == "managed":
        print(
            "Copy this fresh one-time enrollment code to a coordinator, then run "
            "`xedoc-session remote-agent-enroll` there to pair this host."
        )
        result["enrollment"] = remote_agent_enrollment_command("create")
    return result


def run(args: argparse.Namespace) -> list[dict[str, object]] | dict[str, object]:
    if args.command == "remote-agent-pairings":
        return remote_agent_pairings(args)
    if args.command == "remote-agent-enroll":
        return remote_agent_enroll(args)
    if args.command == "remote-agent-configure" and args.uses_default_socket:
        return configure_remote_agent_with_lifecycle(args)
    with AppServerClient(args.socket, args.timeout, args.client_name) as client:
        if args.command == "sessions":
            return list_sessions(client)
        if args.command == "turns":
            return list_running_turns(client, args.thread_id)
        if args.command == "start":
            return send_turn(
                client, args.thread_id, args.prompt, args.client_message_id
            )
        if args.command == "steer":
            return steer_turn(
                client,
                args.thread_id,
                args.turn_id,
                args.prompt,
                args.client_message_id,
            )
        if args.command == "remote-agent-configure":
            return configure_remote_agent(client, args.reconfigure)
        raise AppServerError(f"unsupported command: {args.command}")


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    args.experimental = args.experimental or is_experimental_invocation()
    args.uses_default_socket = args.socket is None
    if args.socket is None:
        args.socket = default_socket_path(args.experimental)
    try:
        result = run(args)
    except (AppServerError, OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
