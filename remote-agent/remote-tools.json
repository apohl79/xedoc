{
  "schemaVersion": 1,
  "contractVersion": "xedoc.remote-agent/v1",
  "namespace": "remote",
  "tools": [
    {
      "name": "remote_hosts_list",
      "description": "List hosts known to the local broker.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "remote_hosts_discover",
      "description": "Discover hosts using the local broker.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "remote_host_pair",
      "description": "Pair a host using the local broker.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "enum": [
              "coordinator",
              "managed"
            ]
          },
          "fingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "hostId",
          "role"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "remote_host_grants_list",
      "description": "List grants for a host using the local broker.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "hostId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "remote_host_grant_set",
      "description": "Set a host grant using the local broker.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hostId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "enum": [
                "discovery",
                "workspaceRead",
                "sessionRead",
                "sessionWrite",
                "cancellation"
              ]
            }
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "threadId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expiresAt": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "hostId",
          "scopes"
        ],
        "additionalProperties": false
      }
    },
    {
