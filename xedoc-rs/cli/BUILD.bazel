load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "xedoc_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "xedoc_e2e_benchmark")

xedoc_rust_crate(
    name = "cli",
    binary_rustc_env_files = ["@xedoc_version//:xedoc_release.env"],
    crate_name = "xedoc_cli",
    extra_binaries = [
        "//xedoc-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
)

multiplatform_binaries(
    name = "xedoc",
)

xedoc_e2e_benchmark(
    name = "xedoc-help",
    binaries = [":xedoc"],
)
