{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModelRouterEffectiveRoute": {
      "oneOf": [
        {
          "properties": {
            "modelSlug": {
              "type": "string"
            },
            "providerId": {
              "type": "string"
            },
            "reasoningEffort": {
              "type": "string"
            },
            "type": {
              "enum": [
                "available"
              ],
              "title": "AvailableModelRouterEffectiveRouteType",
              "type": "string"
            }
          },
          "required": [
            "modelSlug",
            "providerId",
            "reasoningEffort",
            "type"
          ],
          "title": "AvailableModelRouterEffectiveRoute",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "unavailable"
              ],
              "title": "UnavailableModelRouterEffectiveRouteType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "UnavailableModelRouterEffectiveRoute",
          "type": "object"
        }
      ]
    },
    "ModelRouterRoute": {
      "description": "A selectable model route proposed by the model router.",
      "properties": {
        "modelSlug": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        }
      },
      "required": [
        "modelSlug",
        "providerId",
        "reasoningEffort"
      ],
      "type": "object"
    },
    "ModelRouterScope": {
      "enum": [
        "root",
        "subagent"
      ],
      "type": "string"
    }
  },
  "description": "A dedicated, structured request to approve a proposed model route.",
  "properties": {
    "approvalId": {
      "type": "string"
    },
    "classifierRevision": {
      "type": "string"
    },
    "currentRoute": {
      "$ref": "#/definitions/ModelRouterEffectiveRoute"
    },
    "margin": {
      "format": "double",
      "type": "number"
    },
    "policyRevision": {
      "type": "string"
    },
    "predictedClassification": {
      "type": "string"
    },
    "promptSha256": {
      "type": "string"
    },
    "proposedRoute": {
      "$ref": "#/definitions/ModelRouterRoute"
    },
    "scope": {
      "$ref": "#/definitions/ModelRouterScope"
    },
    "score": {
      "format": "double",
      "type": "number"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "approvalId",
    "classifierRevision",
    "currentRoute",
    "margin",
    "policyRevision",
    "predictedClassification",
    "promptSha256",
    "proposedRoute",
    "scope",
    "score",
    "threadId",
    "turnId"
  ],
  "title": "ModelRouterApprovalParams",
  "type": "object"
}