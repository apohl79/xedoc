{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModelRouterApprovalClassRating": {
      "description": "Rating and allowed model range for one approval classification choice.",
      "properties": {
        "maximumModelClass": {
          "type": "string"
        },
        "minimumModelClass": {
          "type": "string"
        },
        "points": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "maximumModelClass",
        "minimumModelClass",
        "points"
      ],
      "type": "object"
    },
    "ModelRouterApprovalRankedRoute": {
      "description": "One available policy-ranked route for approval preview calculation.",
      "properties": {
        "modelClass": {
          "type": "string"
        },
        "rank": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "route": {
          "$ref": "#/definitions/ModelRouterRoute"
        }
      },
      "required": [
        "modelClass",
        "rank",
        "route"
      ],
      "type": "object"
    },
    "ModelRouterEffectiveRoute": {
      "oneOf": [
        {
          "properties": {
            "modelSlug": {
              "type": "string"
            },
            "providerId": {
              "type": "string"
            },
            "reasoningEffort": {
              "type": "string"
            },
            "type": {
              "enum": [
                "available"
              ],
              "title": "AvailableModelRouterEffectiveRouteType",
              "type": "string"
            }
          },
          "required": [
            "modelSlug",
            "providerId",
            "reasoningEffort",
            "type"
          ],
          "title": "AvailableModelRouterEffectiveRoute",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "unavailable"
              ],
              "title": "UnavailableModelRouterEffectiveRouteType",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "UnavailableModelRouterEffectiveRoute",
          "type": "object"
        }
      ]
    },
    "ModelRouterRoute": {
      "description": "A selectable model route proposed by the model router.",
      "properties": {
        "modelSlug": {
          "type": "string"
        },
        "providerId": {
          "type": "string"
        },
        "reasoningEffort": {
          "type": "string"
        }
      },
      "required": [
        "modelSlug",
        "providerId",
        "reasoningEffort"
      ],
      "type": "object"
    },
    "ModelRouterScope": {
      "enum": [
        "root",
        "subagent"
      ],
      "type": "string"
    }
  },
  "description": "A dedicated, structured request to approve a proposed model route.",
  "properties": {
    "approvalId": {
      "type": "string"
    },
    "availableRoutes": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ModelRouterRoute"
      },
      "type": "array"
    },
    "classificationOptions": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "default": {},
      "type": "object"
    },
    "classificationRatings": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/definitions/ModelRouterApprovalClassRating"
        },
        "type": "object"
      },
      "default": {},
      "type": "object"
    },
    "classifications": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "type": "object"
    },
    "classifierRevision": {
      "type": "string"
    },
    "currentRoute": {
      "$ref": "#/definitions/ModelRouterEffectiveRoute"
    },
    "margin": {
      "format": "double",
      "type": "number"
    },
    "policyRevision": {
      "type": "string"
    },
    "predictedClassification": {
      "type": "string"
    },
    "promptSha256": {
      "type": "string"
    },
    "proposedRoute": {
      "$ref": "#/definitions/ModelRouterRoute"
    },
    "rankingLadder": {
      "default": [],
      "items": {
        "$ref": "#/definitions/ModelRouterApprovalRankedRoute"
      },
      "type": "array"
    },
    "rankingMaximumScore": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "rankingMinimumScore": {
      "format": "uint16",
      "minimum": 0.0,
      "type": "integer"
    },
    "scope": {
      "$ref": "#/definitions/ModelRouterScope"
    },
    "score": {
      "format": "double",
      "type": "number"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "approvalId",
    "classifierRevision",
    "currentRoute",
    "margin",
    "policyRevision",
    "predictedClassification",
    "promptSha256",
    "proposedRoute",
    "rankingMaximumScore",
    "rankingMinimumScore",
    "scope",
    "score",
    "threadId",
    "turnId"
  ],
  "title": "ModelRouterApprovalParams",
  "type": "object"
}