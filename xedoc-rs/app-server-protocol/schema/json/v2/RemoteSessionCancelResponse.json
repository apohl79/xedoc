{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "RemoteSessionHostRole": {
      "description": "Role advertised by a remote host.",
      "enum": [
        "coordinator",
        "managed"
      ],
      "type": "string"
    },
    "RemoteSessionStatus": {
      "description": "Lifecycle state reported for a remote session.",
      "enum": [
        "idle",
        "running",
        "completed",
        "failed",
        "cancelled",
        "expired",
        "detached"
      ],
      "type": "string"
    },
    "RemoteSessionSummary": {
      "description": "Root-thread scoped projection of a remote session.",
      "properties": {
        "activeTurnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "activitySummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": "string"
        },
        "hostName": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostRole": {
          "anyOf": [
            {
              "$ref": "#/definitions/RemoteSessionHostRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteSessionId": {
          "type": "string"
        },
        "remoteThreadId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/RemoteSessionStatus"
        },
        "workspaceId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hostId",
        "remoteSessionId",
        "remoteThreadId",
        "status"
      ],
      "type": "object"
    }
  },
  "description": "Result of cancelling a remote session turn.",
  "properties": {
    "remoteSession": {
      "$ref": "#/definitions/RemoteSessionSummary"
    }
  },
  "required": [
    "remoteSession"
  ],
  "title": "RemoteSessionCancelResponse",
  "type": "object"
}