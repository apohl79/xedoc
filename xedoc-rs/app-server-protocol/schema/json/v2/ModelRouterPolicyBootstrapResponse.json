{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModelRouterCapability": {
      "description": "A provider/model route with user-assigned capability tags.",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "model",
        "provider",
        "tags"
      ],
      "type": "object"
    },
    "ModelRouterPolicy": {
      "description": "The stable, user-editable portion of the standalone model-router policy.",
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/definitions/ModelRouterCapability"
          },
          "type": "array"
        },
        "classes": {
          "items": {
            "$ref": "#/definitions/ModelRouterPolicyClass"
          },
          "type": "array"
        },
        "classifierRevision": {
          "type": "string"
        },
        "minimumMargin": {
          "format": "double",
          "type": "number"
        },
        "minimumScore": {
          "format": "double",
          "type": "number"
        },
        "policyRevision": {
          "type": "string"
        }
      },
      "required": [
        "capabilities",
        "classes",
        "classifierRevision",
        "minimumMargin",
        "minimumScore",
        "policyRevision"
      ],
      "type": "object"
    },
    "ModelRouterPolicyClass": {
      "description": "A user-editable routing class in the standalone model-router policy.",
      "properties": {
        "id": {
          "type": "string"
        },
        "minimumReasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        },
        "requiredCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "minimumReasoningEffort",
        "requiredCapabilities"
      ],
      "type": "object"
    },
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    }
  },
  "properties": {
    "created": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/definitions/ModelRouterPolicy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "created"
  ],
  "title": "ModelRouterPolicyBootstrapResponse",
  "type": "object"
}