{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ModelRouterCapability": {
      "description": "A provider/model route with user-assigned capability tags.",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "model",
        "provider",
        "tags"
      ],
      "type": "object"
    },
    "ModelRouterPolicyClass": {
      "description": "A user-editable routing class in the standalone model-router policy.",
      "properties": {
        "id": {
          "type": "string"
        },
        "minimumReasoningEffort": {
          "$ref": "#/definitions/ReasoningEffort"
        },
        "requiredCapabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "minimumReasoningEffort",
        "requiredCapabilities"
      ],
      "type": "object"
    },
    "ReasoningEffort": {
      "description": "A non-empty reasoning effort value advertised by the model.",
      "minLength": 1,
      "type": "string"
    }
  },
  "description": "Replace the user-editable routing policy controls while preserving classifier weights.",
  "properties": {
    "capabilities": {
      "items": {
        "$ref": "#/definitions/ModelRouterCapability"
      },
      "type": "array"
    },
    "classes": {
      "items": {
        "$ref": "#/definitions/ModelRouterPolicyClass"
      },
      "type": "array"
    },
    "minimumMargin": {
      "format": "double",
      "type": "number"
    },
    "minimumScore": {
      "format": "double",
      "type": "number"
    }
  },
  "required": [
    "capabilities",
    "classes",
    "minimumMargin",
    "minimumScore"
  ],
  "title": "ModelRouterPolicyWriteParams",
  "type": "object"
}