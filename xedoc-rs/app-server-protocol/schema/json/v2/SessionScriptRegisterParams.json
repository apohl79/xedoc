{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SessionScriptCapability": {
      "description": "A narrowly scoped action a session script may be granted for its thread.",
      "enum": [
        "userInput.send",
        "prompt.requestUserInput.respond",
        "prompt.approval.respond"
      ],
      "type": "string"
    },
    "SessionScriptIdentityParams": {
      "description": "Identifies a script that is connected to one loaded root thread.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "SessionScriptPromptKind": {
      "description": "A prompt class that a session script may observe.",
      "enum": [
        "requestUserInput",
        "extensionInteraction",
        "commandExecutionApproval",
        "fileChangeApproval",
        "permissionsApproval",
        "mcpElicitation"
      ],
      "type": "string"
    },
    "SessionScriptSubscriptionsParams": {
      "description": "Selects the bounded stream of events delivered to a session script.",
      "properties": {
        "modelResponseCompleted": {
          "type": "boolean"
        },
        "modelResponseDeltas": {
          "type": "boolean"
        },
        "prompts": {
          "items": {
            "$ref": "#/definitions/SessionScriptPromptKind"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "sessionUpdates": {
          "type": "boolean"
        },
        "turnCompleted": {
          "type": "boolean"
        },
        "userMessages": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "description": "Registers the initialized connection as a restricted session script.",
  "properties": {
    "requestedCapabilities": {
      "items": {
        "$ref": "#/definitions/SessionScriptCapability"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "script": {
      "$ref": "#/definitions/SessionScriptIdentityParams"
    },
    "subscriptions": {
      "$ref": "#/definitions/SessionScriptSubscriptionsParams"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "script",
    "subscriptions",
    "threadId"
  ],
  "title": "SessionScriptRegisterParams",
  "type": "object"
}